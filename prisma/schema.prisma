generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DIGITAL
  PHYSICAL
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
  FULFILLED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  shortDescription String
  description      String
  type             ProductType       @default(PHYSICAL)
  status           PublicationStatus @default(DRAFT)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  /// Price in euro cents (server-trusted)
  priceCents       Int
  compareAtCents   Int?
  currency         String            @default("EUR")
  stock            Int?
  sku              String?
  features         String            @default("[]")
  images           String            @default("[]")
  previewNote      String?
  seoTitle         String?
  seoDescription   String?
  weightGrams      Int?
  requiresShipping Boolean           @default(false)
  sortOrder        Int               @default(0)
  licences         LicenceOption[]
  downloadFiles    DownloadFile[]
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, type])
  @@index([categoryId])
}

model LicenceOption {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  /// Price in euro cents (server-trusted)
  priceCents  Int
  maxSeats    Int?
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  orderItems  OrderItem[]

  @@unique([productId, code])
}

model DownloadFile {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String
  storagePath  String
  contentType  String         @default("application/zip")
  byteSize     Int?
  checksumSha256 String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  downloadTokens DownloadToken[]
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  customerEmail   String
  customerName    String
  customerPhone   String?
  companyName     String?
  shippingAddress String?
  currency        String        @default("EUR")
  subtotalCents   Int
  taxCents        Int           @default(0)
  shippingCents   Int           @default(0)
  totalCents      Int
  taxInclusive    Boolean       @default(true)
  notes           String?
  paymentProvider String?
  providerRef     String?
  paidAt          DateTime?
  items           OrderItem[]
  paymentEvents   PaymentEvent[]
  downloadTokens  DownloadToken[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  licenceOptionId String?
  licenceOption  LicenceOption? @relation(fields: [licenceOptionId], references: [id])
  productName    String
  licenceName    String?
  unitPriceCents Int
  quantity       Int            @default(1)
  lineTotalCents Int
}

model PaymentEvent {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  eventType       String
  providerEventId String?
  payloadJson     String
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([orderId])
}

model DownloadToken {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  downloadFileId String
  downloadFile   DownloadFile @relation(fields: [downloadFileId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  maxDownloads   Int          @default(5)
  downloadCount  Int          @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

model Enquiry {
  id                String         @id @default(cuid())
  name              String
  email             String
  company           String?
  website           String?
  service           String
  paymentProvider   String?
  description       String
  preferredContact  String         @default("email")
  status            EnquiryStatus  @default(NEW)
  honeypot          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([email])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
