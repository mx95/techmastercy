# Copy to .env and fill in values. Never commit real secrets.
# On the Hetzner server the live file is /opt/techmastercy/.env (mode 640, root:tmcdeploy).

# Local development:
DATABASE_URL="file:./dev.db"
# Production (Docker named volume mount):
# DATABASE_URL="file:/data/techmastercy.db"

APP_URL="http://localhost:3000"
SITE_URL="https://techmaster.com.cy"
NODE_ENV="development"
# Production: NODE_ENV="production"

# Admin session cookies: leave unset to follow X-Forwarded-Proto (http IP preview = not Secure).
# Set COOKIE_SECURE=true only when the site is reached over HTTPS.
# COOKIE_SECURE="false"

# Required — generate with: openssl rand -base64 48
SESSION_SECRET=""

# Used by prisma/seed.ts to create the first admin user (change immediately after first login)
ADMIN_EMAIL="admin@techmaster.com.cy"
ADMIN_PASSWORD=""

# Payment provider: "mock" (dev only), "jcc", or "revolut_link" (Revolut Pro static payment links)
# Mock payments are refused when NODE_ENV=production unless ALLOW_MOCK_PAYMENTS is explicitly "true"
# Do not set ALLOW_MOCK_PAYMENTS=true in production.
PAYMENT_PROVIDER="mock"
ALLOW_MOCK_PAYMENTS="true"
# Used by mock webhook/complete flows (dev only)
MOCK_WEBHOOK_SECRET="mock-dev-secret"

# Revolut Pro payment links (PAYMENT_PROVIDER=revolut_link)
# Defaults are baked into src/content/revolut-payment-offers.ts; env overrides are optional:
# REVOLUT_LINK_OTTOCAST_1="https://checkout.revolut.com/pay/..."   # €89.99
# REVOLUT_LINK_AIRTAG_1="https://checkout.revolut.com/pay/..."     # €6.99
# REVOLUT_LINK_AIRTAG_2="https://checkout.revolut.com/pay/..."     # €11.99
# REVOLUT_LINK_AIRTAG_4="https://checkout.revolut.com/pay/..."     # €19.99


# Optional marker set by deploy tooling (do not put secrets here)
# DEPLOY_GIT_SHA=""


# JCC — populate only from official merchant documentation/credentials
JCC_MERCHANT_ID=""
JCC_API_KEY=""
JCC_API_SECRET=""
JCC_BASE_URL=""
JCC_WEBHOOK_SECRET=""

# SMTP (optional). Without these, enquiries are stored but email is not sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TechmasterCY <noreply@techmaster.com.cy>"
BUSINESS_EMAIL="support@techmaster.com.cy"

TAX_RATE_BPS="1900"
TAX_INCLUSIVE="true"

DOWNLOAD_TOKEN_TTL_HOURS="72"
DOWNLOAD_MAX_ATTEMPTS="5"
PRIVATE_FILES_DIR="./storage/private"
